pkgname=ash
pkgver="${ASH_VERSION:?ASH_VERSION must be set}"
release_tag="${ASH_RELEASE_TAG:-v${pkgver}}"
pkgrel=1
pkgdesc="A shell assistant for command-not-found workflows"
arch=('x86_64')
url="https://www.versionx.ai"
license=('MIT')
depends=('gcc-libs' 'glibc')
optdepends=('python: enable Python-based tools')
options=('!debug')
source=('ash.tar.gz')
sha256sums=("${ASH_ARCHIVE_SHA256:?ASH_ARCHIVE_SHA256 must be set}")

package() {
  install -Dm0755 "$srcdir/ash-${release_tag}-linux-amd64" "$pkgdir/usr/bin/ash"
  install -Dm0755 "$srcdir/ash-broker" "$pkgdir/usr/bin/ash-broker"
  install -Dm0644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/ash/LICENSE"
  install -Dm0644 "$srcdir/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/ash/THIRD_PARTY_NOTICES.md"
  install -Dm0755 "$srcdir"/plugins/* -t "$pkgdir/usr/lib/ash/plugins"
  install -d "$pkgdir/usr/share/man"
  cp -a "$srcdir/usr/share/man/." "$pkgdir/usr/share/man/"
}
