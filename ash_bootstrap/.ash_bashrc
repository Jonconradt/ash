# >>> ash install >>>
[ -f "$HOME/.ash/.ash_env" ] && . "$HOME/.ash/.ash_env"
case "$-" in
	*i*) ;;
	*) return ;;
esac

_ash_ensure_broker() {
	[[ -n "${AI_ENDPOINT:-}" && -n "${AI_MODEL:-}" ]] || return 1
	if [[ -n "${ASH_BROKER_SOCKET:-}" && -n "${ASH_BROKER_TOKEN:-}" && -S "$ASH_BROKER_SOCKET" && -n "${ASH_BROKER_PID:-}" ]] && kill -0 "$ASH_BROKER_PID" 2>/dev/null; then
		return 0
	fi
	local runtime_dir="$HOME/.ash/runtime"
	local socket_path="$runtime_dir/${SESSION_ID:-shell}.sock"
	local lease_path="$runtime_dir/${SESSION_ID:-shell}.lease"
	local token
	runtime_dir="${runtime_dir%/}"
	if ! mkdir -p -m 700 "$runtime_dir"; then
		return 1
	fi
	if ! touch "$lease_path"; then
		return 1
	fi
	token="$(head -c 32 /dev/urandom | LC_ALL=C od -An -tx1 | tr -d ' \n')"
	if [[ -z "$token" ]]; then
		return 1
	fi
	# Launching from a subshell keeps bash's job-start notice off the terminal; the
	# pid is handed back through a file because $! is not visible to the parent.
	local pid_path="$runtime_dir/${SESSION_ID:-shell}.pid"
	( ASH_BROKER_TOKEN="$token" command ash broker --socket "$socket_path" --lease "$lease_path" </dev/null >/dev/null 2>&1 & printf '%s' "$!" > "$pid_path" )
	local broker_pid
	broker_pid="$(cat "$pid_path" 2>/dev/null)"
	rm -f "$pid_path" 2>/dev/null
	if [[ -z "$broker_pid" ]]; then
		return 1
	fi
	local attempt
	for attempt in {1..40}; do
		if [[ -S "$socket_path" ]]; then
			touch "$lease_path"
			export ASH_BROKER_SOCKET="$socket_path" ASH_BROKER_TOKEN="$token" ASH_BROKER_PID="$broker_pid" ASH_BROKER_LEASE="$lease_path"
			return 0
		fi
		if ! kill -0 "$broker_pid" 2>/dev/null; then
			return 1
		fi
		sleep 0.01
	done
	return 1
}

_ash_ensure_broker >/dev/null 2>&1

_ash_prompt_processing_enabled() {
	local snooze_file="$HOME/.ash/.ash_snooze_until"
	local expires_at now
	if [[ ! -r "$snooze_file" ]]; then
		return 0
	fi
	expires_at="$(<"$snooze_file")"
	if [[ ! "$expires_at" =~ ^[0-9]+$ ]]; then
		return 0
	fi
	now="$(date +%s)"
	(( expires_at <= now ))
}

command_not_found_handle() {
	if _ash_prompt_processing_enabled; then
		_ash_ensure_broker >/dev/null 2>&1
		[[ -n "${ASH_BROKER_LEASE:-}" ]] && touch "$ASH_BROKER_LEASE"
		ash "$@"
		return $?
	fi
	return 127
}

# Question words that can open the second position of a natural-language line.
_ash_leading_question_word() {
	case "$1" in
		[Ii][Ss]|[Aa][Rr][Ee]|[Aa][Mm]|[Dd][Oo]|[Dd][Oo][Ee][Ss]|[Dd][Ii][Dd]|[Cc][Aa][Nn]|[Cc][Oo][Uu][Ll][Dd]|[Ss][Hh][Oo][Uu][Ll][Dd]|[Ww][Oo][Uu][Ll][Dd]|[Ww][Ii][Ll][Ll]|[Ww][Hh][Yy]|[Hh][Oo][Ww]|[Ww][Hh][Ee][Nn]|[Ww][Hh][Ee][Rr][Ee]|[Ww][Hh][Oo])
			return 0
			;;
	esac
	return 1
}

# The heuristic itself lives in Go (ash route --check) so every shell shares one
# implementation. These guards only reject inputs that Go could never route, and
# they stay fork-free so ordinary command use never pays for a subprocess.
_ash_should_route() {
	local cmd="$1"
	shift
	local argc=$#
	[[ $argc -ge 2 ]] || return 1

	local a
	for a in "$@"; do
		[[ "$a" == -* ]] && return 1
	done

	case "$cmd" in
		what|What|which|Which|who|Who|where|Where|at|At|in|In|for|For|write|Write) ;;
		*)
			local last="${!argc}"
			[[ "$last" == *\? ]] || _ash_leading_question_word "$1" || return 1
			;;
	esac

	command ash route --check -- "$cmd" "$@"
}

_ash_route_or_delegate() {
  local cmd="$1"
  shift
	if ! _ash_prompt_processing_enabled; then
		command "$cmd" "$@"
		return $?
	fi
  if _ash_should_route "$cmd" "$@"; then
	_ash_ensure_broker >/dev/null 2>&1
		[[ -n "${ASH_BROKER_LEASE:-}" ]] && touch "$ASH_BROKER_LEASE"
    ash "$cmd" "$@"
    return $?
  fi
  command "$cmd" "$@"
}

_ash_route_or_delegate_builtin() {
  local builtin_name="$1"
  shift
	if ! _ash_prompt_processing_enabled; then
		builtin "$builtin_name" "$@"
		return $?
	fi
  if _ash_should_route "$builtin_name" "$@"; then
	_ash_ensure_broker >/dev/null 2>&1
		[[ -n "${ASH_BROKER_LEASE:-}" ]] && touch "$ASH_BROKER_LEASE"
    ash "$builtin_name" "$@"
    return $?
  fi
  builtin "$builtin_name" "$@"
}

what()  { _ash_route_or_delegate what  "$@"; }
What()  { _ash_route_or_delegate What  "$@"; }
write() { _ash_route_or_delegate write "$@"; }
Write() { _ash_route_or_delegate Write "$@"; }
which() { _ash_route_or_delegate which "$@"; }
Which() { _ash_route_or_delegate Which "$@"; }
who()   { _ash_route_or_delegate who   "$@"; }
Who()   { _ash_route_or_delegate Who   "$@"; }
say()   { _ash_route_or_delegate say   "$@"; }
Say()   { _ash_route_or_delegate Say   "$@"; }
at()    { _ash_route_or_delegate at    "$@"; }
At()    { _ash_route_or_delegate At    "$@"; }
In()    { _ash_route_or_delegate In    "$@"; }
For()   { _ash_route_or_delegate For   "$@"; }

test()  { _ash_route_or_delegate_builtin test "$@"; }
Test()  { _ash_route_or_delegate_builtin test "$@"; }
type()  { _ash_route_or_delegate_builtin type "$@"; }
Type()  { _ash_route_or_delegate_builtin type "$@"; }
Time()  { _ash_route_or_delegate Time "$@"; }
# <<< ash install <<<
