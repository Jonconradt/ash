# >>> ash install >>>
[ -f "$HOME/.ash/.ash_env" ] && . "$HOME/.ash/.ash_env"

zmodload -i zsh/datetime 2>/dev/null

_ash_ensure_broker() {
	[[ -n "${AI_ENDPOINT:-}" && -n "${AI_MODEL:-}" ]] || return 1
	if [[ -n "${ASH_BROKER_SOCKET:-}" && -n "${ASH_BROKER_TOKEN:-}" && -S "$ASH_BROKER_SOCKET" && -n "${ASH_BROKER_PID:-}" ]] && kill -0 "$ASH_BROKER_PID" 2>/dev/null; then
		return 0
	fi
	local runtime_dir="$HOME/.ash/runtime"
	local socket_path="$runtime_dir/${SESSION_ID:-shell}.sock"
	local lease_path="$runtime_dir/${SESSION_ID:-shell}.lease"
	local token
	if ! mkdir -p -m 700 "$runtime_dir"; then
		return 1
	fi
	if ! touch "$lease_path"; then
		return 1
	fi
	token="$(head -c 32 /dev/urandom | LC_ALL=C od -An -tx1 | tr -d ' \n')"
	if [[ -z "$token" ]]; then
		return 1
	fi
	# &! backgrounds and disowns atomically, so no job-control notice reaches the terminal.
	ASH_BROKER_TOKEN="$token" command ash broker --socket "$socket_path" --lease "$lease_path" </dev/null >/dev/null 2>&1 &!
	local broker_pid=$!
	local attempt
	for attempt in {1..40}; do
		if [[ -S "$socket_path" ]]; then
			touch "$lease_path"
			export ASH_BROKER_SOCKET="$socket_path" ASH_BROKER_TOKEN="$token" ASH_BROKER_PID="$broker_pid" ASH_BROKER_LEASE="$lease_path"
			return 0
		fi
		if ! kill -0 "$broker_pid" 2>/dev/null; then
			return 1
		fi
		sleep 0.01
	done
	return 1
}

_ash_shutdown_broker() {
	[[ -n "${ASH_BROKER_PID:-}" ]] && kill -TERM "$ASH_BROKER_PID" 2>/dev/null
	[[ -n "${ASH_BROKER_LEASE:-}" ]] && rm -f "$ASH_BROKER_LEASE" 2>/dev/null
	return 0
}

_ash_prompt_processing_enabled() {
	local snooze_file="$HOME/.ash/.ash_snooze_until"
	[[ -r "$snooze_file" ]] || return 0
	local expires_at
	read -r expires_at < "$snooze_file" 2>/dev/null || return 0
	[[ "$expires_at" == <-> ]] || return 0
	(( expires_at <= ${EPOCHSECONDS:-$(date +%s)} ))
}

typeset -gA _ash_ambiguous_words
# >>> ash route words >>>
_ash_ambiguous_words=(at 1 for 1 in 1 test 1 time 1 type 1 what 1 where 1 which 1 who 1 write 1)
# <<< ash route words <<<

# Guards are ordered cheapest-first and stay fork-free so real commands are never slowed down.
_ash_should_route_buffer() {
	local buf="$1"
	[[ "$buf" == *[$'\n'"|;&<>\`"]* ]] && return 1
	[[ "$buf" == *'$('* ]] && return 1
	local first="${buf%%[[:space:]]*}"
	[[ "$first" == [A-Za-z]* && "$first" != *[^A-Za-z0-9_.-]* ]] || return 1
	if (( ${+commands[$first]} || ${+functions[$first]} || ${+aliases[$first]} || ${+builtins[$first]} || ${+reswords[$first]} )); then
		(( ${+_ash_ambiguous_words[${first:l}]} )) || return 1
		_ash_prompt_processing_enabled || return 1
		command ash route --check -- "$buf" || return 1
		return 0
	fi
	_ash_prompt_processing_enabled || return 1
	return 0
}

_ash_orig_accept_line=.accept-line

_ash_accept_line() {
	if [[ "$CONTEXT" == start ]] && _ash_should_route_buffer "$BUFFER"; then
		_ash_ensure_broker >/dev/null 2>&1
		[[ -n "${ASH_BROKER_LEASE:-}" ]] && touch "$ASH_BROKER_LEASE"
		# Requoting the whole line keeps globs, reserved words, and a trailing ? away from zsh.
		BUFFER="ash ${(q-)BUFFER}"
	fi
	zle "$_ash_orig_accept_line" -- "$@"
}

_ash_install_widget() {
	case "${widgets[accept-line]:-}" in
		user:_ash_accept_line) return 0 ;;
		user:*)
			zle -A accept-line _ash_saved_accept_line
			_ash_orig_accept_line=_ash_saved_accept_line
			;;
		*) _ash_orig_accept_line=.accept-line ;;
	esac
	zle -N accept-line _ash_accept_line
}

# Deferred to the first prompt so plugins loaded after this file wrap our widget, not the reverse.
_ash_install_widget_once() {
	_ash_install_widget
	add-zsh-hook -d precmd _ash_install_widget_once
}

if autoload -Uz add-zsh-hook 2>/dev/null && whence add-zsh-hook >/dev/null 2>&1; then
	add-zsh-hook precmd _ash_install_widget_once
	add-zsh-hook zshexit _ash_shutdown_broker
fi

command_not_found_handler() {
	[[ -o interactive ]] || return 127
	if _ash_prompt_processing_enabled; then
		_ash_ensure_broker >/dev/null 2>&1
		[[ -n "${ASH_BROKER_LEASE:-}" ]] && touch "$ASH_BROKER_LEASE"
		ash "$@"
	else
		return 127
	fi
	return $?
}

_ash_ensure_broker >/dev/null 2>&1
# <<< ash install <<<
