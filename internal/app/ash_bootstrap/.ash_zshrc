# >>> ash install >>>
[[ -o interactive ]] || return
_ash_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/ash"
_ash_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ash"
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
	_ash_runtime_dir="$XDG_RUNTIME_DIR/ash"
else
	_ash_runtime_dir="$_ash_state_dir/runtime"
fi
[[ -f "$_ash_config_dir/.ash_env" ]] && . "$_ash_config_dir/.ash_env"

zmodload -i zsh/datetime 2>/dev/null

_ash_ensure_broker() {
	local mcp_credential_key="${ASH_MCP_CREDENTIAL_KEY:-}"
	unset ASH_MCP_CREDENTIAL_KEY
	local session_id="${ASH_SESSION_ID:-}"
	if [[ -z "$session_id" ]]; then
		session_id="$(head -c 100 /dev/urandom | LC_ALL=C tr -dc 'a-zA-Z0-9' | fold -w 16 | head -n 1)"
		[[ -n "$session_id" ]] || return 1
		export ASH_SESSION_ID="$session_id"
	fi
	[[ -n "${ASH_AI_ENDPOINT:-}" && -n "${ASH_AI_MODEL:-}" ]] || return 1
	# Without this probe a missing ash-broker reaches command_not_found_handler, which
	# would forward the broker's own command line to the AI as a prompt.
	command -v ash-broker >/dev/null 2>&1 || return 1
	if [[ -n "${ASH_BROKER_SOCKET:-}" && -n "${ASH_BROKER_TOKEN:-}" && -S "$ASH_BROKER_SOCKET" && -n "${ASH_BROKER_PID:-}" ]] && kill -0 "$ASH_BROKER_PID" 2>/dev/null; then
		return 0
	fi
	local runtime_dir="$_ash_runtime_dir"
	local socket_path="$runtime_dir/$session_id.sock"
	local token
	if ! mkdir -p -m 700 "$runtime_dir"; then
		return 1
	fi
	token="$(head -c 32 /dev/urandom | LC_ALL=C od -An -tx1 | tr -d ' \n')"
	if [[ -z "$token" ]]; then
		return 1
	fi
	# &! backgrounds and disowns atomically, so no job-control notice reaches the terminal.
	local parent_pid="$$"
	ASH_BROKER_TOKEN="$token" ASH_MCP_CREDENTIAL_KEY="$mcp_credential_key" command ash-broker --socket "$socket_path" --session-id "$session_id" --parent-pid "$parent_pid" </dev/null >/dev/null 2>&1 &!
	unset mcp_credential_key
	local broker_pid=$!
	local attempt
	for attempt in {1..40}; do
		if [[ -S "$socket_path" ]]; then
			export ASH_BROKER_SOCKET="$socket_path" ASH_BROKER_TOKEN="$token" ASH_BROKER_PID="$broker_pid"
			return 0
		fi
		if ! kill -0 "$broker_pid" 2>/dev/null; then
			return 1
		fi
		sleep 0.01
	done
	return 1
}

_ash_shutdown_broker() {
	[[ -n "${ASH_BROKER_PID:-}" ]] && kill -TERM "$ASH_BROKER_PID" 2>/dev/null
	return 0
}

_ash_prompt_processing_enabled() {
	local snooze_file="$_ash_state_dir/.ash_snooze_until"
	[[ -r "$snooze_file" ]] || return 0
	local expires_at
	read -r expires_at < "$snooze_file" 2>/dev/null || return 0
	[[ "$expires_at" == <-> ]] || return 0
	(( expires_at <= ${EPOCHSECONDS:-$(date +%s)} ))
}

typeset -gA _ash_ambiguous_words
# >>> ash route words >>>
_ash_ambiguous_words=(at 1 for 1 in 1 say 1 test 1 time 1 type 1 what 1 where 1 which 1 who 1 write 1)
# <<< ash route words <<<

# Guards are ordered cheapest-first and stay fork-free so real commands are never slowed down.
_ash_should_route_buffer() {
	local buf="$1"
	[[ "$buf" == *[$'\n'"|;&<>\`"]* ]] && return 1
	[[ "$buf" == *'$('* ]] && return 1
	local first="${buf%%[[:space:]]*}"
	[[ "$first" == [A-Za-z]* && "$first" != *[^A-Za-z0-9_.-]* ]] || return 1
	if (( ${+commands[$first]} || ${+functions[$first]} || ${+aliases[$first]} || ${+builtins[$first]} || ${+reswords[$first]} )); then
		(( ${+_ash_ambiguous_words[${first:l}]} )) || return 1
		_ash_prompt_processing_enabled || return 1
		command ash route --check -- "$buf" || return 1
		return 0
	fi
	_ash_prompt_processing_enabled || return 1
	return 0
}

_ash_orig_accept_line=.accept-line

_ash_accept_line() {
	if [[ "$CONTEXT" == start ]] && _ash_should_route_buffer "$BUFFER"; then
		_ash_ensure_broker >/dev/null 2>&1
		# Requoting the whole line keeps globs, reserved words, and a trailing ? away from zsh.
		if [[ "${BUFFER%%[[:space:]]*}" == say ]] && command -v say >/dev/null 2>&1; then
			BUFFER="ash --say ${(q-)BUFFER}"
		else
			BUFFER="ash -- ${(q-)BUFFER}"
		fi
	fi
	zle "$_ash_orig_accept_line" -- "$@"
}

_ash_install_widget() {
	case "${widgets[accept-line]:-}" in
		user:_ash_accept_line) return 0 ;;
		user:*)
			zle -A accept-line _ash_saved_accept_line
			_ash_orig_accept_line=_ash_saved_accept_line
			;;
		*) _ash_orig_accept_line=.accept-line ;;
	esac
	zle -N accept-line _ash_accept_line
}

# Deferred to the first prompt so plugins loaded after this file wrap our widget, not the reverse.
_ash_install_widget_once() {
	_ash_install_widget
	add-zsh-hook -d precmd _ash_install_widget_once
}

if autoload -Uz add-zsh-hook 2>/dev/null && whence add-zsh-hook >/dev/null 2>&1; then
	add-zsh-hook precmd _ash_install_widget_once
	add-zsh-hook zshexit _ash_shutdown_broker
fi

if [[ "${_ASH_WRAPS_COMMAND_NOT_FOUND:-}" != 1 ]]; then
	if (( $+functions[command_not_found_handler] )); then
		functions -c command_not_found_handler _ash_original_command_not_found_handler
	fi
	_ASH_WRAPS_COMMAND_NOT_FOUND=1
fi

command_not_found_handler() {
	[[ -o interactive ]] || return 127
	if _ash_prompt_processing_enabled; then
		_ash_ensure_broker >/dev/null 2>&1
		ash -- "$@"
		return $?
	fi
	if (( $+functions[_ash_original_command_not_found_handler] )); then
		_ash_original_command_not_found_handler "$@"
		return $?
	fi
	return 127
}

ash() {
	if [[ "${1:-}" == "mcp" && "${2:-}" == "add" ]]; then
		_ash_ensure_broker >/dev/null 2>&1
		[[ -n "${ASH_BROKER_LEASE:-}" ]] && touch "$ASH_BROKER_LEASE"
	fi
	command ash "$@"
}

_ash_ensure_broker >/dev/null 2>&1
# <<< ash install <<<
