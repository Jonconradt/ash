# ash command, tool, and plugin allowlist
#
# This file is read by ash to allow Unix command execution, managed tools, and
# native plugins through the run_unix_command and run_unix_pipeline tools.
#
# Format rules:
# - One command per line (preferred), or comma-separated on one line.
# - Lines starting with # are comments.
# - Use bare executable names only (no paths, no arguments).
#
# Safety model:
# - Keep this list conservative by default.
# - Prefer read/inspect commands over mutating commands.
# - Avoid destructive tools (rm, mv, dd, chmod, chown, kill, sudo, etc).
#
# Notes:
# - ASH_ALLOW environment variable overrides this file.
# - Any command, tool, or plugin listed in .ash_deny (or ASH_DENY) is blocked.
# - python3 always runs through ash's dedicated run_python3 tool, never here.
#
# -----------------------------------------------------------------------------
# Managed tools and native plugins
# -----------------------------------------------------------------------------
# $TOOLS_DIR_LIST is an internal Ash directive that expands to eligible Python
# scripts in ~/.ash/tools/.
$TOOLS_DIR_LIST

# $PLUGINS_DIR_LIST is an internal Ash directive that expands to eligible native
# binary plugins in ~/.ash/plugins/.
$PLUGINS_DIR_LIST

# -----------------------------------------------------------------------------
# Core shell information
# -----------------------------------------------------------------------------
pwd
ls
whoami
id
uname
hostname
date
cal
printenv
env
echo

# -----------------------------------------------------------------------------
# File and directory inspection
# -----------------------------------------------------------------------------
stat
file
du
df
find
readlink
realpath

# -----------------------------------------------------------------------------
# Text and content inspection
# -----------------------------------------------------------------------------
cat
head
tail
less
wc
nl
cut
paste
tr
sort
uniq
awk
sed
grep
egrep
fgrep
strings
column

# -----------------------------------------------------------------------------
# Process and system observability
# -----------------------------------------------------------------------------
ps
pgrep
top
uptime
sysctl
vm_stat
iostat

# -----------------------------------------------------------------------------
# Networking and connectivity diagnostics
# -----------------------------------------------------------------------------
ping6
traceroute6
ifconfig
netstat
lsof
host
nslookup
dig
drill
sockstat
scutil

# -----------------------------------------------------------------------------
# Documentation and help
# -----------------------------------------------------------------------------
man
which

# -----------------------------------------------------------------------------
# Structured data helpers
# -----------------------------------------------------------------------------
jq
# python3 is intentionally excluded: it always runs through run_python3 instead.

# -----------------------------------------------------------------------------
# Additional read-only diagnostics (safe and useful for Linux/macOS)
# -----------------------------------------------------------------------------
lsblk
lscpu
free
who
w
groups
ss
ip
route
arp
lsmod
locale
sha256sum
mount
timeout

diskutil
system_profiler
ioreg
networksetup
defaults
airport
dscacheutil
xattr

# -----------------------------------------------------------------------------
# macOS-specific utilities
# -----------------------------------------------------------------------------
osascript
open
say
mdfind
mdls
sw_vers
