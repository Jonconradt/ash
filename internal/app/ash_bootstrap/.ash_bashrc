# >>> ash install >>>
case "$-" in
	*i*) ;;
	*) return ;;
esac
if [[ "${_ASH_LOCAL_BIN_ON_PATH:-}" != 1 ]]; then
	PATH="$HOME/.local/bin:$PATH"
	export PATH
	_ASH_LOCAL_BIN_ON_PATH=1
fi
_ash_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/ash"
_ash_data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/ash"
_ash_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ash"
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
	_ash_runtime_dir="$XDG_RUNTIME_DIR/ash"
else
	_ash_runtime_dir="$_ash_state_dir/runtime"
fi
[[ -f "$_ash_config_dir/.ash_env" ]] && . "$_ash_config_dir/.ash_env"

_ash_ensure_broker() {
	local mcp_credential_key="${ASH_MCP_CREDENTIAL_KEY:-}"
	unset ASH_MCP_CREDENTIAL_KEY
	local session_id="${ASH_SESSION_ID:-}"
	if [[ -z "$session_id" ]]; then
		session_id="$(head -c 100 /dev/urandom | LC_ALL=C tr -dc 'a-zA-Z0-9' | fold -w 16 | head -n 1)"
		[[ -n "$session_id" ]] || return 1
		export ASH_SESSION_ID="$session_id"
	fi
	[[ -n "${ASH_AI_ENDPOINT:-}" && -n "${ASH_AI_MODEL:-}" ]] || return 1
	# Without this probe a missing ash-broker reaches command_not_found_handle, which
	# would forward the broker's own command line to the AI as a prompt.
	command -v ash-broker >/dev/null 2>&1 || return 1
	if [[ -n "${ASH_BROKER_SOCKET:-}" && -n "${ASH_BROKER_TOKEN:-}" && -S "$ASH_BROKER_SOCKET" && -n "${ASH_BROKER_PID:-}" ]] && kill -0 "$ASH_BROKER_PID" 2>/dev/null; then
		return 0
	fi
	local runtime_dir="$_ash_runtime_dir"
	local socket_path="$runtime_dir/$session_id.sock"
	local token
	runtime_dir="${runtime_dir%/}"
	if ! mkdir -p -m 700 "$runtime_dir"; then
		return 1
	fi
	token="$(head -c 32 /dev/urandom | LC_ALL=C od -An -tx1 | tr -d ' \n')"
	if [[ -z "$token" ]]; then
		return 1
	fi
	# Launching from a subshell keeps bash's job-start notice off the terminal; the
	# pid is handed back through a file because $! is not visible to the parent.
	local pid_path="$runtime_dir/$session_id.pid"
	local parent_pid="$BASHPID"
	( ASH_BROKER_TOKEN="$token" ASH_MCP_CREDENTIAL_KEY="$mcp_credential_key" command ash-broker --socket "$socket_path" --session-id "$session_id" --parent-pid "$parent_pid" </dev/null >/dev/null 2>&1 & printf '%s' "$!" > "$pid_path" )
	unset mcp_credential_key
	local broker_pid
	broker_pid="$(cat "$pid_path" 2>/dev/null)"
	rm -f "$pid_path" 2>/dev/null
	if [[ -z "$broker_pid" ]]; then
		return 1
	fi
	local attempt
	for attempt in {1..40}; do
		if [[ -S "$socket_path" ]]; then
			export ASH_BROKER_SOCKET="$socket_path" ASH_BROKER_TOKEN="$token" ASH_BROKER_PID="$broker_pid"
			return 0
		fi
		if ! kill -0 "$broker_pid" 2>/dev/null; then
			return 1
		fi
		sleep 0.01
	done
	return 1
}

_ash_ensure_broker >/dev/null 2>&1

_ash_prompt_processing_enabled() {
	local snooze_file="$_ash_state_dir/.ash_snooze_until"
	local expires_at now
	if [[ ! -r "$snooze_file" ]]; then
		return 0
	fi
	expires_at="$(<"$snooze_file")"
	if [[ ! "$expires_at" =~ ^[0-9]+$ ]]; then
		return 0
	fi
	now="$(date +%s)"
	(( expires_at <= now ))
}

if [[ "${_ASH_WRAPS_COMMAND_NOT_FOUND:-}" != 1 ]]; then
	if declare -F command_not_found_handle >/dev/null 2>&1; then
		eval "$(declare -f command_not_found_handle | sed '1s/command_not_found_handle/_ash_original_command_not_found_handle/')"
	fi
	_ASH_WRAPS_COMMAND_NOT_FOUND=1
fi

command_not_found_handle() {
	if _ash_prompt_processing_enabled; then
		if ! builtin type -P ash >/dev/null 2>&1; then
			if declare -F _ash_original_command_not_found_handle >/dev/null 2>&1; then
				_ash_original_command_not_found_handle "$@"
				return $?
			fi
			printf '%s: command not found\n' "$1" >&2
			return 127
		fi
		_ash_ensure_broker >/dev/null 2>&1
		command ash -- "$@"
		return $?
	fi
	if declare -F _ash_original_command_not_found_handle >/dev/null 2>&1; then
		_ash_original_command_not_found_handle "$@"
		return $?
	fi
	return 127
}

ash() {
	if ! builtin type -P ash >/dev/null 2>&1; then
		printf '%s\n' "ash: command not found" >&2
		return 127
	fi
	if [[ "${1:-}" == "mcp" && "${2:-}" == "add" ]]; then
		_ash_ensure_broker >/dev/null 2>&1
	fi
	command ash "$@"
}

# Question words that can open the second position of a natural-language line.
_ash_leading_question_word() {
	case "$1" in
		[Ii][Ss]|[Aa][Rr][Ee]|[Aa][Mm]|[Dd][Oo]|[Dd][Oo][Ee][Ss]|[Dd][Ii][Dd]|[Cc][Aa][Nn]|[Cc][Oo][Uu][Ll][Dd]|[Ss][Hh][Oo][Uu][Ll][Dd]|[Ww][Oo][Uu][Ll][Dd]|[Ww][Ii][Ll][Ll]|[Ss][Hh][Aa][Ll][Ll]|[Mm][Aa][Yy]|[Mm][Ii][Gg][Hh][Tt]|[Mm][Uu][Ss][Tt]|[Oo][Uu][Gg][Hh][Tt]|[Ww][Hh][Yy]|[Hh][Oo][Ww]|[Ww][Hh][Ee][Nn]|[Ww][Hh][Ee][Rr][Ee]|[Ww][Hh][Oo]|[Ww][Hh][Oo][Mm]|[Ww][Hh][Oo][Ss][Ee])
			return 0
			;;
	esac
	return 1
}

# The heuristic itself lives in Go (ash route --check) so every shell shares one
# implementation. These guards only reject inputs that Go could never route, and
# they stay fork-free so ordinary command use never pays for a subprocess.
_ash_should_route() {
	local cmd="$1"
	shift
	local argc=$#
	[[ $argc -ge 2 ]] || return 1

	local a
	for a in "$@"; do
		[[ "$a" == -* ]] && return 1
	done

	case "$cmd" in
		what|What|which|Which|who|Who|where|Where|at|At|in|In|for|For|write|Write) ;;
		what|What|which|Which|who|Who|where|Where|at|At|in|In|for|For|write|Write|say|Say) ;;
		*)
			local last="${!argc}"
			[[ "$last" == *\? ]] || _ash_leading_question_word "$1" || return 1
			;;
	esac

	builtin type -P ash >/dev/null 2>&1 || return 1
	command ash route --check -- "$cmd" "$@"
}

_ash_route_or_delegate() {
  local cmd="$1"
  shift
	if ! _ash_prompt_processing_enabled; then
		command "$cmd" "$@"
		return $?
	fi
  if _ash_should_route "$cmd" "$@"; then
	_ash_ensure_broker >/dev/null 2>&1
	ash -- "$cmd" "$@"
    return $?
  fi
  command "$cmd" "$@"
}

_ash_route_or_delegate_builtin() {
  local builtin_name="$1"
  shift
	if ! _ash_prompt_processing_enabled; then
		builtin "$builtin_name" "$@"
		return $?
	fi
  if _ash_should_route "$builtin_name" "$@"; then
	_ash_ensure_broker >/dev/null 2>&1
	ash -- "$builtin_name" "$@"
    return $?
  fi
  builtin "$builtin_name" "$@"
}

_ash_route_or_delegate_say() {
	local cmd="$1"
	shift
	if ! _ash_prompt_processing_enabled; then
		command "$cmd" "$@"
		return $?
	fi
	if _ash_should_route "$cmd" "$@"; then
		if command -v say >/dev/null 2>&1; then
			ash --say "$cmd" "$@"
			return $?
		fi
		ash -- "$cmd" "$@"
		return $?
	fi
	command "$cmd" "$@"
}

what()  { _ash_route_or_delegate what  "$@"; }
What()  { _ash_route_or_delegate What  "$@"; }
write() { _ash_route_or_delegate write "$@"; }
Write() { _ash_route_or_delegate Write "$@"; }
which() { _ash_route_or_delegate which "$@"; }
Which() { _ash_route_or_delegate Which "$@"; }
who()   { _ash_route_or_delegate who   "$@"; }
Who()   { _ash_route_or_delegate Who   "$@"; }
say()   { _ash_route_or_delegate_say say   "$@"; }
Say()   { _ash_route_or_delegate_say Say   "$@"; }
at()    { _ash_route_or_delegate at    "$@"; }
At()    { _ash_route_or_delegate At    "$@"; }
In()    { _ash_route_or_delegate In    "$@"; }
For()   { _ash_route_or_delegate For   "$@"; }

test()  { _ash_route_or_delegate_builtin test "$@"; }
Test()  { _ash_route_or_delegate_builtin test "$@"; }
type()  { _ash_route_or_delegate_builtin type "$@"; }
Type()  { _ash_route_or_delegate_builtin type "$@"; }
Time()  { _ash_route_or_delegate Time "$@"; }
# <<< ash install <<<
