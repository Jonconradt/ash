#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mapfile -d '' -t go_files < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.go')

if [[ ${#go_files[@]} -eq 0 ]]; then
	exit 0
fi

go run ./scripts/eid-injector -- "${go_files[@]}"
git add -- "${go_files[@]}"
